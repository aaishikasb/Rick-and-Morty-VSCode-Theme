  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#99a19b",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#dfe7e1",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "variable.language"
      ],
      "settings": {
        "foreground": "#d6aef4",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#99a19b",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#79ccfb",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#d6c06f",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#88d5a3",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#f0b376",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f0b376",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties and attributes",
      "scope": [
        "support.type.property-name",
        "variable.other.property",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#79ccfb",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#d6aef4",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#d6c06f",
        "fontStyle": ""
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#d6c06f",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid code",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ffa59e",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Inserted text",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#88d5a3",
        "fontStyle": ""
      }
    },
    {
      "name": "Deleted text",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ffa59e",
        "fontStyle": ""
      }
    },
    {
      "name": "Changed text",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#79ccfb",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#d6c06f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#88d5a3",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown code fences",
      "scope": [
        "punctuation.definition.fenced",
        "variable.language.fenced"
      ],
      "settings": {
        "foreground": "#99a19b",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#79ccfb",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#dfe7e1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#dfe7e1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown bold emphasis",
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "foreground": "#dfe7e1",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown quotes and list markers",
      "scope": [
        "markup.quote",
        "punctuation.definition.list.begin"
      ],
      "settings": {
        "foreground": "#99a19b",
        "fontStyle": ""
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#99a19b",
    "variable": "#dfe7e1",
    "parameter": "#dfe7e1",
    "property": "#79ccfb",
    "variable.readonly": "#f0b376",
    "property.readonly": "#f0b376",
    "namespace": "#d6c06f",
    "type": "#d6c06f",
    "class": "#d6c06f",
    "enum": "#d6c06f",
    "interface": "#d6c06f",
    "struct": "#d6c06f",
    "typeParameter": "#d6c06f",
    "function": "#79ccfb",
    "method": "#79ccfb",
    "macro": "#d6c06f",
    "decorator": "#d6c06f",
    "enumMember": "#f0b376",
    "keyword": "#d6aef4",
    "modifier": "#d6aef4",
    "string": "#88d5a3",
    "number": "#f0b376",
    "regexp": "#f0b376",
    "operator": "#99a19b",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
