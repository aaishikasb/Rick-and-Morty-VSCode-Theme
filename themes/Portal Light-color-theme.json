  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#53534d",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#2a2924",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "variable.language"
      ],
      "settings": {
        "foreground": "#613d7a",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#53534d",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#00577a",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#5f4f00",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#036035",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#734300",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#734300",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties and attributes",
      "scope": [
        "support.type.property-name",
        "variable.other.property",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#00577a",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#613d7a",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#5f4f00",
        "fontStyle": ""
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#5f4f00",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid code",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#8d2425",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Inserted text",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#036035",
        "fontStyle": ""
      }
    },
    {
      "name": "Deleted text",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#8d2425",
        "fontStyle": ""
      }
    },
    {
      "name": "Changed text",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#00577a",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#5f4f00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#036035",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown code fences",
      "scope": [
        "punctuation.definition.fenced",
        "variable.language.fenced"
      ],
      "settings": {
        "foreground": "#53534d",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#00577a",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#2a2924",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#2a2924",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown bold emphasis",
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "foreground": "#2a2924",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown quotes and list markers",
      "scope": [
        "markup.quote",
        "punctuation.definition.list.begin"
      ],
      "settings": {
        "foreground": "#53534d",
        "fontStyle": ""
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#53534d",
    "variable": "#2a2924",
    "parameter": "#2a2924",
    "property": "#00577a",
    "variable.readonly": "#734300",
    "property.readonly": "#734300",
    "namespace": "#5f4f00",
    "type": "#5f4f00",
    "class": "#5f4f00",
    "enum": "#5f4f00",
    "interface": "#5f4f00",
    "struct": "#5f4f00",
    "typeParameter": "#5f4f00",
    "function": "#00577a",
    "method": "#00577a",
    "macro": "#5f4f00",
    "decorator": "#5f4f00",
    "enumMember": "#734300",
    "keyword": "#613d7a",
    "modifier": "#613d7a",
    "string": "#036035",
    "number": "#734300",
    "regexp": "#734300",
    "operator": "#53534d",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
